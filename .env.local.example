# ──────────────────────────────────────────────────────────
# ArchTitan OS — Environment Variables
# ──────────────────────────────────────────────────────────
# Get your free Resend API key at: https://resend.com
# Free tier: 100 emails/day, no credit card required.

RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Use onboarding@resend.dev for testing (no domain verification needed)
# Or your own verified sender domain once you set it up in Resend dashboard
RESEND_FROM_EMAIL=onboarding@resend.dev
